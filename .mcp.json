{
  "mcpServers": {
    "motion": {
      "type": "http",
      "url": "https://mcp.motion.dev"
    },
    "motion-plus": {
      "type": "http",
      "url": "https://mcp.motion.dev/plus"
    },
    "agentation": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "agentation-mcp",
        "server"
      ]
    },
    "Sanity": {
      "type": "http",
      "url": "https://mcp.sanity.io"
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "talcrm": {
      "type": "stdio",
      "command": "node",
      "args": [
        ".claude/mcp/talcrm-mcp.mjs"
      ]
    }
  }
}
